rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             (!('bloodType' in data) || data.bloodType == null || (data.bloodType is string && data.bloodType.size() <= 10)) &&
             (!('allergies' in data) || data.allergies == null || (data.allergies is string && data.allergies.size() <= 500)) &&
             (!('emergencyNotes' in data) || data.emergencyNotes == null || (data.emergencyNotes is string && data.emergencyNotes.size() <= 1000)) &&
             (!('regionCode' in data) || data.regionCode == null || (data.regionCode is string && data.regionCode.size() <= 50));
    }

    function isValidChecklistItem(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             data.isChecked is bool;
    }

    function isValidEmergencyContact(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             data.relationship is string && data.relationship.size() > 0 && data.relationship.size() <= 100;
    }

    function isValidFeedbackReport(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5;
    }

    function isValidDisasterAlert(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.severity is string && data.severity.size() > 0 && data.severity.size() <= 50 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.locationCity is string && data.locationCity.size() > 0 && data.locationCity.size() <= 100 &&
             (!('sourceAgency' in data) || data.sourceAgency == null || (data.sourceAgency is string && data.sourceAgency.size() <= 100)) &&
             (!('isTest' in data) || data.isTest is bool);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'phone', 'bloodType', 'allergies', 'emergencyNotes', 'regionCode', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'bloodType', 'allergies', 'emergencyNotes', 'regionCode', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // User Checklist Items
      match /checklist_items/{itemId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().id == itemId &&
                         incoming().keys().hasAll(['id', 'userId', 'title', 'category', 'isChecked', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'category', 'description', 'isChecked', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChecklistItem(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChecklistItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'description', 'isChecked', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Emergency Contacts
      match /contacts/{contactId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().id == contactId &&
                         incoming().keys().hasAll(['id', 'userId', 'name', 'phone', 'relationship', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'name', 'phone', 'relationship', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidEmergencyContact(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidEmergencyContact(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'relationship', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Feedback and Incident Reports
    match /feedback/{feedbackId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().id == feedbackId &&
                       incoming().keys().hasAll(['id', 'userId', 'userName', 'category', 'message', 'rating', 'createdAt']) &&
                       incoming().keys().hasOnly(['id', 'userId', 'userName', 'category', 'message', 'rating', 'createdAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidFeedbackReport(incoming());

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Disaster Alerts and Broadcasts
    match /alerts/{alertId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       incoming().id == alertId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['id', 'userId', 'title', 'category', 'severity', 'message', 'locationCity', 'createdAt']) &&
                       incoming().keys().hasOnly(['id', 'userId', 'title', 'category', 'severity', 'message', 'locationCity', 'sourceAgency', 'isTest', 'createdAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidDisasterAlert(incoming());

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
